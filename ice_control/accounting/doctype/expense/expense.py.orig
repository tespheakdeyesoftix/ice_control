import frappe
from frappe.model.document import Document

from ice_control.accounting.doctype.expense.accounting import (
	delete_gl_entries,
	submit_to_gl_entry,
)


class Expense(Document):
	# begin: auto-generated types
	# This code is auto-generated. Do not modify anything in this block.

	from typing import TYPE_CHECKING

	if TYPE_CHECKING:
		from frappe.types import DF
		from ice_control.accounting.doctype.expense_items.expense_items import ExpenseItems

		amended_from: DF.Link | None
		balance: DF.Currency
		default_payable_account: DF.Link
		expense_by_employee: DF.Link
		expense_items: DF.Table[ExpenseItems]
		naming_series: DF.Literal["EXP.YYYY.-.####"]
		note: DF.SmallText | None
		outlet: DF.Link
		photo: DF.AttachImage | None
		posting_date: DF.Date
		reference_number: DF.Data | None
		status: DF.Literal["Unpaid", "Partially Paid", "Paid"]
		total_expense: DF.Currency
		total_payment: DF.Currency
		total_write_off: DF.Currency
		vendor: DF.Link
	# end: auto-generated types

	_DOCTYPE_NAME = "Expense"

	def validate(self):
		for d in self.expense_items:
			d.total_amount = (d.price or 0) * (d.quantity or 0) 

		self.total_expense = sum([d.total_amount for d in self.expense_items])
		self.balance = (self.total_expense or 0) - ((self.total_payment or 0) + (self.total_write_off or 0))

	def on_submit(self):
		submit_to_gl_entry(self)

	def on_cancel(self):
		delete_gl_entries(self)

	@frappe.whitelist()
	def get_payment_history(self):
		return frappe.db.sql(
			"""
				SELECT
					payment.name AS payment_number,
					payment.posting_date AS payment_date,
					invoice.payment_amount,
					invoice.write_off_amount,
					payment.owner AS created_by,
					payment.creation
				FROM `tabExpense Payment Invoices` invoice
				INNER JOIN `tabExpense Payment` payment
					ON payment.name = invoice.parent
				WHERE invoice.expense = %(expense)s
					AND invoice.docstatus = 1
					AND payment.docstatus = 1
				ORDER BY payment.posting_date DESC, payment.creation DESC
			""",
			{"expense": self.name},
			as_dict=True,
		)


	def on_update_after_submit(self):
		frappe.msgprint(str( self.has_value_changed("note")))
