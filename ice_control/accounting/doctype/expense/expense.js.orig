// main table event
frappe.ui.form.on("Expense", {
   
    refresh(frm){
        renderSummary(frm);
        addExpensePaymentButton(frm);
    }

});



// chid table event
frappe.ui.form.on("Expense Items", {

    // expense_items_remove(frm) {
    //     alert("u remove me")
    // },
    
    //  expense_items_add(frm) {
    //     alert("u add me")
    // },

    quantity(frm, cdt, cdn) {
        const row = frappe.get_doc(cdt, cdn);

        calculateExpenseItemRow(frm, row)
    },
    price(frm, cdt, cdn) {
        const row = frappe.get_doc(cdt, cdn);

        calculateExpenseItemRow(frm, row)
    },


	
});

function addExpensePaymentButton(frm) {
    if (frm.doc.docstatus !== 1 || flt(frm.doc.balance) <= 0) {
        return;
    }

    frm.add_custom_button(
        __("Payment"),
        () => {
            frappe.model.with_doctype("Expense Payment", () => {
                const payment = frappe.model.get_new_doc(
                    "Expense Payment",
                    null,
                    null,
                    true
                );

                frappe.route_options = {
                    expense: frm.doc.name,
                    outlet: frm.doc.outlet,
                    vendor: frm.doc.vendor,
                };
                frappe.set_route("Form", "Expense Payment", payment.name);
            });
        },
        __("Actions")
    );
}

function renderSummary(frm){
     const html = frappe.render_template("expense_summary", frm.doc);
        $(frm.fields_dict['html_expense_summary'].wrapper).html(html);
}


function summaryTotal(frm){
    const total_amount = (frm.doc.expense_items || []).reduce(
    (sum, row) => sum + (Number(row.total_amount) || 0),
    0
);

        frm.doc.total_expense = total_amount

        renderSummary(frm);
        frm.refresh_field("total_expense");
}
function calculateExpenseItemRow(frm,row){
            row.total_amount = (row.quantity ?? 0) * (row.price ?? 0)
            summaryTotal(frm)
        frm.refresh_field("expense_items");
}


