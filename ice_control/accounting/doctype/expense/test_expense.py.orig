from unittest.mock import patch

import frappe
from frappe.tests import IntegrationTestCase

from ice_control.accounting.doctype.expense.accounting import submit_to_gl_entry
from ice_control.accounting.doctype.expense.expense import Expense


# On IntegrationTestCase, the doctype test records and all
# link-field test record dependencies are recursively loaded
# Use these module variables to add/remove to/from that list
EXTRA_TEST_RECORD_DEPENDENCIES = []  # eg. ["User"]
IGNORE_TEST_RECORD_DEPENDENCIES = []  # eg. ["User"]



class IntegrationTestExpense(IntegrationTestCase):
	"""
	Integration tests for Expense.
	Use this class for testing interactions between multiple components.
	"""

	@patch(
		"ice_control.accounting.doctype.expense.accounting.submit_general_ledger_entry"
	)
	@patch("ice_control.accounting.doctype.expense.accounting.get_account_type")
	@patch("ice_control.accounting.doctype.expense.accounting.frappe.get_cached_value")
	@patch("ice_control.accounting.doctype.expense.accounting.delete_gl_entries")
	def test_submit_to_gl_entry_posts_expense_and_payable_entries(
		self,
		delete_entries,
		get_cached_value,
		get_account_type,
		submit_entries,
	):
		get_cached_value.return_value = "Test Vendor"
		get_account_type.side_effect = {
			"TEST-FOOD": "Expense",
			"TEST-DELIVERY": "Expense",
			"TEST-AP": "Payable",
		}.get
		expense = frappe._dict(
			name="TEST-EXPENSE-1",
			outlet="TEST-OUTLET",
			posting_date="2026-09-05",
			vendor="TEST-VENDOR",
			default_payable_account="TEST-AP",
			note=None,
			expense_items=[
				frappe._dict(idx=1, expense_code="TEST-FOOD", total_amount=60),
				frappe._dict(idx=2, expense_code="TEST-FOOD", total_amount=40),
				frappe._dict(idx=3, expense_code="TEST-DELIVERY", total_amount=20),
			],
		)

		submit_to_gl_entry(expense)

		delete_entries.assert_called_once_with(expense)
		get_cached_value.assert_called_once_with(
			"Vendor", "TEST-VENDOR", "vendor_name"
		)
		submit_entries.assert_called_once()
		entries = submit_entries.call_args.args[0]
		self.assertFalse(submit_entries.call_args.kwargs["run_commit"])
		self.assertEqual(len(entries), 3)
		self.assertEqual(sum(row.get("debit_amount") or 0 for row in entries), 120)
		self.assertEqual(sum(row.get("credit_amount") or 0 for row in entries), 120)

		entries_by_account = {row["account"]: row for row in entries}
		self.assertEqual(entries_by_account["TEST-FOOD"]["debit_amount"], 100)
		self.assertEqual(entries_by_account["TEST-DELIVERY"]["debit_amount"], 20)
		self.assertEqual(entries_by_account["TEST-AP"]["credit_amount"], 120)
		self.assertEqual(entries_by_account["TEST-AP"]["party_type"], "Vendor")
		self.assertEqual(entries_by_account["TEST-AP"]["party"], "TEST-VENDOR")
