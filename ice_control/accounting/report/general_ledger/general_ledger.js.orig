frappe.query_reports["General Ledger"] = {
	formatter(value, row, column, data, default_formatter) {
		const formatted_value = default_formatter(value, row, column, data);

		if (data && Number(data.is_total) === 1) {
			if (column.fieldname === "account" || column.id === "account") {
				const label = frappe.utils.escape_html(String(value || ""));
				return `<div style="font-weight: 700;">${label}</div>`;
			}
			return `<div style="font-weight: 700;">${formatted_value}</div>`;
		}

		return formatted_value;
	},

	filters: [
		{
			fieldname: "outlet",
			label: __("Outlet"),
			fieldtype: "Link",
			options: "Outlet",
			default: frappe.boot.employee_outlet || "",
		},
		{
			fieldname: "start_date",
			label: __("Start Date"),
			fieldtype: "Date",
			default: frappe.datetime.month_start(),
			reqd: 1,
		},
		{
			fieldname: "end_date",
			label: __("End Date"),
			fieldtype: "Date",
			default: frappe.datetime.month_end(),
			reqd: 1,
		},
		{
			fieldname: "party_type",
			label: __("Party Type"),
			fieldtype: "Link",
			options: "DocType",
			get_query() {
				return {
					filters: {
						name: ["in", ["Customer", "Vendor", "Employee"]],
					},
				};
			},
			on_change(query_report) {
				if (query_report.get_filter_value("party")) {
					query_report.set_filter_value("party", "");
				}
			},
		},
		{
			fieldname: "party",
			label: __("Party"),
			fieldtype: "Dynamic Link",
			options: "party_type",
			get_query() {
				const party_type = frappe.query_report.get_filter_value("party_type");
				return party_type ? { doctype: party_type } : {};
			},
		},
	],
};
